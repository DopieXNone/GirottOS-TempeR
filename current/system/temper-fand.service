[Unit]
Description=TempeR fan control (fan curves) and keyboard light
Documentation=file:///usr/share/doc/girottos-temper/README.md
# start after the programs whose fan control it pauses
After=asusd.service coolercontrold.service power-profiles-daemon.service

[Service]
Type=dbus
BusName=com.girottos.TempeR.FanControl
ExecStart=/usr/bin/temper-fand
Restart=on-failure
RestartSec=3
# /etc/temper (curves) and /var/lib/temper (what it paused)
ConfigurationDirectory=temper
StateDirectory=temper
# it only writes hwmon files in /sys; systemctl and asusctl go over D-Bus
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
